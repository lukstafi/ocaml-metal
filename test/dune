; This test fails if run on CI "paravirtual machine".

(executable
 (name advanced_tests_icb)
 (libraries metal ctypes.foreign))

(rule
 (alias runtest)
 (enabled_if
  (= %{env:OCAML_METAL_SKIP_ICB_TEST=false} false))
 (deps advanced_tests_icb.expected)
 (action
  (progn
   (with-stdout-to advanced_tests_icb.output (run %{exe:advanced_tests_icb.exe}))
   (diff advanced_tests_icb.expected advanced_tests_icb.output))))

; CI GPU family does not support MSL 3.2 / logging.

(executable
 (name logging_tests)
 (libraries metal ctypes.foreign))

(rule
 (alias runtest)
 (enabled_if
  (= %{env:OCAML_METAL_SKIP_LOGGING_TEST=false} false))
 (deps logging_tests.expected)
 (action
  (progn
   (with-stdout-to logging_tests.output (run %{exe:logging_tests.exe}))
   (diff logging_tests.expected logging_tests.output))))
