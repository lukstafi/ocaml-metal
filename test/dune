(executable
 (name basic_tests)
 (libraries metal ctypes.foreign))

(rule
 (alias runtest)
 (deps basic_tests.expected)
 (action
  (progn
   (with-stdout-to basic_tests.output (run %{exe:basic_tests.exe}))
   (diff basic_tests.expected basic_tests.output))))

